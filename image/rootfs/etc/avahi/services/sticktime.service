<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- StickTime Pi: the settings page shows up in network browsers (http://<hostname>.local) -->
<service-group>
  <name replace-wildcards="yes">StickTime Pi on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
