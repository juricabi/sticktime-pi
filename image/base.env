# The Raspberry Pi OS Lite (64-bit) images image/build.sh can start from, pinned by URL and sha256.
# Sourced by build.sh (shell syntax) and hashed by the CI cache key. Never use *_latest URLs.
#
# Default: 2026-04-21 (kernel 6.12.75), the kernel composite video was verified on
# (raspberrypi/trixie-feedback#66). The 2026-10-06 image (kernel 6.18.50) works the same way for
# everything image/ does (checked: user pi, cloud-init, userconfig, partition table), but composite
# on 6.18 is not verified on hardware yet. Try it with:  sudo BASE=2026-10-06 image/build.sh
#
# A new entry needs: <ID>_URL, <ID>_SHA256 (the .img.xz), <ID>_SIZE (bytes, a sanity check) and
# <ID>_KERNEL (for the notes), with ID = the date with '-' as '_'. Re-check the facts in
# image/README.md ("Changing the base image") before making it the default.

BASE_DEFAULT=2026-04-21

BASE_2026_04_21_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-04-21/2026-04-21-raspios-trixie-arm64-lite.img.xz
BASE_2026_04_21_SHA256=4cd31df026fd82243805a326dc0cafd7383f7e3d30c9413e7044d507aae281e2
BASE_2026_04_21_SIZE=577362320
BASE_2026_04_21_KERNEL=6.12.75

BASE_2026_10_06_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-10-06/2026-10-06-raspios-trixie-arm64-lite.img.xz
BASE_2026_10_06_SHA256=483db18a48da399b5b7022ffae9a07bc6d99daab30e593aedac09b69ff422843
BASE_2026_10_06_SIZE=550466056
BASE_2026_10_06_KERNEL=6.18.50

# The game shipped in the image when GAME_ZIP / GAME_VERSION are not given (CI passes the newest
# release and its digest instead). Releases can be re-uploaded under the same tag: then the
# sha256 check fails on purpose, and this pin has to be updated.
GAME_VERSION_DEFAULT=1.7.2
GAME_SHA256_DEFAULT=572d19a844b579e09b6c8072c22cde2a4b545480e9fc644fa39a057d35e47b00
GAME_REPO=juricabi/sticktime
GALLERY_URL=https://juricabi.github.io/sticktime/tracks/index.json
